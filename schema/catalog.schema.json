{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apps.adeleon.dev/schema/catalog.schema.json",
  "title": "Instala catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "publisher",
    "categories",
    "apps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "publisher": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/app"
      }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "required": [
        "id",
        "name",
        "tagline",
        "category",
        "status",
        "links",
        "requires",
        "packages",
        "release",
        "preview"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$"
        },
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "status": {
          "enum": [
            "preview",
            "active",
            "maintenance",
            "archived"
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "icon": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "iconPng": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "alt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "links": {
          "type": "object",
          "required": [
            "homepage",
            "repository",
            "releases",
            "issues"
          ],
          "properties": {
            "homepage": {
              "type": "string",
              "format": "uri"
            },
            "repository": {
              "type": "string",
              "format": "uri"
            },
            "releases": {
              "type": "string",
              "format": "uri"
            },
            "issues": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "object",
          "properties": {
            "homebrew": {
              "type": "string"
            },
            "winget": {
              "type": "string"
            }
          }
        },
        "release": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/release"
            }
          ]
        },
        "preview": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/release"
            }
          ]
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "version",
        "tag",
        "publishedAt",
        "notesUrl",
        "assets"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$"
        },
        "tag": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notesUrl": {
          "type": "string",
          "format": "uri"
        },
        "checksumsUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "os",
        "arch",
        "kind",
        "name",
        "url",
        "size",
        "sha256"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signatureUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    }
  }
}
